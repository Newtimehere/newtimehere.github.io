<script>
(function(){
  const ov=document.getElementById('nt-overlay');
  const yes=document.getElementById('nt-yes');
  const no=document.getElementById('nt-no');
  const audio=document.getElementById('newTimeAudio');
  if(yes){
    yes.onclick=()=>{
      if(audio){audio.volume=0.7;audio.currentTime=0;audio.play().catch(()=>{});}
      localStorage.setItem('newtime_legal_ok','1');
      ov.classList.add('hide');
      setTimeout(()=>ov.remove(),400);
    };
  }
  if(no){no.onclick=()=>{window.location.href='https://www.google.com';};}
})();

(function(){
  var gate=document.getElementById('gate21');
  var link=document.getElementById('link21');
  var btnNo=document.getElementById('btnNo');
  var btnYes=document.getElementById('btnYes');
  if(!gate||!link) return;
  link.addEventListener('click',function(e){
    e.preventDefault();
    gate.classList.add('show');
  });
  if(btnNo) btnNo.onclick=function(){gate.classList.remove('show');};
  if(btnYes) btnYes.onclick=function(){window.location.href='physical-sex-fraud.pdf';};
})();
</script>
